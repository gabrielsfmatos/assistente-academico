# Copie este arquivo para ".env" e preencha os valores.
# O .env NUNCA vai para o GitHub (está no .gitignore). Este exemplo vai, sem segredos.

# Chave da API do Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=

# Modelo usado pelo agente (rode "python -m scripts.check_gemini" para ver as opções)
GEMINI_MODEL=gemini-2.5-flash

# Quanto o modelo "pensa" antes de responder: minimal | low | medium | high
GEMINI_THINKING=low

# Segundos mínimos entre chamadas à API (60 / limite de chamadas por minuto do seu plano)
GEMINI_MIN_INTERVAL=7

# Token do bot do Telegram (@BotFather) e o seu ID de usuário (o bot só responde a ele)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
